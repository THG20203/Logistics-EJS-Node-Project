<div class="button__section mt-xl">
  <a href="<%= primaryHref %>" class="button button--primary">
    <div class="button__section--content"><%= primaryText %>
    <span class="material-symbols-outlined" aria-hidden="true">
      chevron_right
    </span>
</div>
</a>

  <% if (secondaryHref && secondaryText) { %>
    <a href="<%= secondaryHref %>" class="button button--secondary">
      <div class="button__section--content"><%= secondaryText %>
        <span class="material-symbols-outlined" aria-hidden="true">
          chevron_right
        </span>
      </div>
    </a>
  <% } %>
</div>
