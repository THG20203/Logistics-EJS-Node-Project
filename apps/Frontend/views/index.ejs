<!DOCTYPE html>
<html lang="en">
  <!-- header for every page -->
  <%- include('partials/head') -%>
  <body>
    <!-- navbar for every page -->
    <%- include("partials/header") %>
    <main class="hero">
      <!-- Fold Content -->
      <div class="hero__content">
        <h1 class="accent">Nationwide and European transport solutions</h1>
        <!-- Need to make this -->
        <p class="h1 hero__heading mt-xxs">Reliable UK Haulage</p>
        <!-- <p class="h1 hero__heading mt-xxs">Pallet Distribution</p> -->
        <!-- <p class="h1 hero__heading mt-xxs">European Freight</p> -->
        <!-- <p class="h1 hero__heading mt-xxs">Secure Warehousing</p> -->
        <p class="mt-sm hero__description">
          From 7.5-tonne rigid vehicles to 44-tonne articulated lorries, we
          provide dependable road haulage across the UK and Europe, with
          flexible scheduling, time-critical planning and clear communication
          from collection to delivery.
        </p>
        <%- include("partials/buttons",
          {
          primaryHref: '#', 
          primaryText: 'Get a quote', 
          secondaryHref: '#', 
          secondaryText: 'Customer login'}) -%>
      </div>
      <div class="hero__image">
        <img
          src="/assets/img/hero/hero.webp"
          alt="THG Logistics haulage vehicle"
        />
      </div>
    </main>

    <!-- Trust section -->
    <%- include('partials/trust') %>

    <!-- Who we are -->
    <section class="who-we-are">

    </section>

    <!-- footer for every page -->
    <%- include('partials/footer') %>
    <!-- Partials scripts tag here -->
    <%- include("partials/scripts") %>
  </body>
</html>


