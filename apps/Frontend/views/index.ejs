<!DOCTYPE html>
<html lang="en">
  <!-- header for every page -->
  <%- include('partials/head') -%>
  <body>
    <!-- navbar for every page -->
    <%- include("partials/header") %>
    <main class="hero">
      <!-- Fold Text -->
      <div class="hero__content">
        <h1>Reliable UK Haulage</h1>
        <h4>Nationwide and European transport solutions</h4>
        <p>
          From 7.5-tonne rigid vehicles to 44-tonne articulated lorries, we
          provide dependable road haulage across the UK and Europe, with
          flexible scheduling, time-critical planning and clear communication
          from collection to delivery.
        </p>
      </div>
      <div class="hero__image">
        <img
          src="/assets/img/hero/hero.webp"
          alt="THG Logistics haulage vehicle"
        />
      </div>
    </main>
    <div class="container">
      <!-- footer for every page -->
      <%- include('partials/footer') %>
      <!-- Partials scripts tag here -->
      <%- include("partials/scripts") %>
    </div>
  </body>
</html>
