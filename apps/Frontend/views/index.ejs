<!DOCTYPE html>
<html lang="en">
  <!-- header for every page -->
  <%- include('partials/head') -%>
  <body>
    <!-- navbar for every page -->
    <%- include("partials/header") %>
    <main class="hero">
      <!-- Fold Content -->
      <div class="hero__content">
        <h1 class="accent">Nationwide and European transport solutions</h1>
        <!-- Need to make this -->
        <p class="h1 hero__heading mt-xxs">Reliable UK Haulage</p>
        <!-- <p class="h1 hero__heading mt-xxs">Pallet Distribution</p> -->
        <!-- <p class="h1 hero__heading mt-xxs">European Freight</p> -->
        <!-- <p class="h1 hero__heading mt-xxs">Secure Warehousing</p> -->
        <p class="mt-sm hero__description">
          From 7.5-tonne rigid vehicles to 44-tonne articulated lorries, we
          provide dependable road haulage across the UK and Europe, with
          flexible scheduling, time-critical planning and clear communication
          from collection to delivery.
        </p>
        <%- include("partials/buttons",
          {
          primaryHref: '#', 
          primaryText: 'Get a quote', 
          secondaryHref: '#', 
          secondaryText: 'Customer login'}) -%>
      </div>
      <div class="hero__image">
        <img
          src="/assets/img/hero/hero.webp"
          alt="THG Logistics haulage vehicle"
        />
      </div>
    </main>

    <!-- Trust section -->
    <%- include('partials/trust') %>

    <!-- Who we are -->
    <section class="who">
      <div class="who__content">
        <div class="who__text-section">
          <p class="accent who__accent">Who we are</p>
          <h2 class="h2 mt-xs">Experienced logistics professionals keeping businesses moving</h2>
          <p class='mt-sm'> THG Logistics Group UK is an independent haulage and logistics company
            supporting businesses with reliable transport, experienced drivers and
            responsive customer service.</p>
          <p class="mt-xxs"> Our knowledgeable team plans every movement
            carefully, combining practical industry expertise with a modern,
            well-maintained fleet to help customers manage changing schedules,
            demanding delivery requirements and complex supply chains.</p>
          <div class="mt-xl">
            <a href="#" class="button button--ghost who__button">
              <div class="button__section--content">
                About Us
                <span class="material-symbols-outlined" aria-hidden="true">
                  chevron_right
                </span>
              </div>
            </a>
          </div>
        </div>
        <div class="who__image-section">
          <div class="who__image-item who__image-item--one">
            <img src="/assets/img/company/main-office-floor.webp" alt="Main office floor" />
          </div>
          <div class="who__image-item who__image-item--two">
             <img src="/assets/img/company/meeting-lady-stoodup.webp" alt="Meetng Lady Stood Up" />
          </div>
          <div class="who__image-item who__image-item--three">
            <img src="/assets/img/new-livery/cab-closeup.webp" alt="Cab Close Up" />
          </div>
        </div>
      </div>
    </section>

    <!-- footer for every page -->
    <%- include('partials/footer') %>
    <!-- Partials scripts tag here -->
    <%- include("partials/scripts") %>
  </body>
</html>


