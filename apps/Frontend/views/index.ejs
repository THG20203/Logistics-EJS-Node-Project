<!DOCTYPE html>
<html lang="en">
  <!-- header for every page -->
  <%- include('partials/head') -%>
  <body>
    <!-- navbar for every page -->
    <%- include("partials/header") %>
    <main class="hero">
      <!-- Fold Content -->
      <div class="hero__content">
        <h1 class="accent">Nationwide and European transport solutions</h1>
        <!-- Need to make this -->
        <p class="h1 hero__heading mt-xxs">Reliable UK Haulage</p>
        <!-- <p class="h1 hero__heading mt-xxs">Pallet Distribution</p> -->
