<section class="service-video">
  <div class="service-video__content">
    <!-- Video -->
    <div class="video-wrapper">
      <video class="video-wrapper__video" preload="metadata">
        <source src="/assets/videos/services-video.mp4" type="video/mp4" />
      </video>
      <button class="video-wrapper__play" aria-label="Play video">
        <svg viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>
    </div>
    <!-- Stats -->
    <div class="service-video__stats">
      <div class="service-video__stat service-video__stat--first">
        <div
          class="service-video__icon-container service-video__icon-container--first"
        >
          <span
            class="material-symbols-outlined service-video__icon service-video__icon--first"
          >
            local_shipping
          </span>
        </div>
        <h3
          class="h3 service-video__heading service-video__heading--first mt-sm"
        >
          200+
        </h3>
        <p
          class="mt-xxs service-video__paragraph service-video__paragraph--first"
        >
          Modern vehicles
        </p>
      </div>
      <div class="service-video__stat service-video__stat--second">
        <div
          class="service-video__icon-container service-video__icon-container--second"
        >
          <span
            class="material-symbols-outlined service-video__icon service-video__icon--second"
            aria-hidden="true"
          >
            move_up
          </span>
        </div>
        <h3
          class="h3 service-video__heading service-video__heading--second mt-sm"
        >
          10,000+
        </h3>
        <p
          class="mt-xxs service-video__paragraph service-video__paragraph--second"
        >
          Loads moved each year
        </p>
      </div>
      <div class="service-video__stat service-video__stat--second">
        <div
          class="service-video__icon-container service-video__icon-container--second"
        >
          <span
            class="material-symbols-outlined service-video__icon service-video__icon--second"
            aria-hidden="true"
          >
            verified
          </span>
        </div>
        <h3
          class="h3 service-video__heading service-video__heading--second mt-sm"
        >
          99.5%
        </h3>
        <p
          class="mt-xxs service-video__paragraph service-video__paragraph--second"
        >
          Damage-free consignments
        </p>
      </div>
      <div class="service-video__stat service-video__stat--second">
        <div
          class="service-video__icon-container service-video__icon-container--second"
        >
          <span
            class="material-symbols-outlined service-video__icon service-video__icon--second"
            aria-hidden="true"
          >
            history
          </span>
        </div>
        <h3
          class="h3 service-video__heading service-video__heading--second mt-sm"
        >
          25+
        </h3>
        <p
          class="mt-xxs service-video__paragraph service-video__paragraph--second"
        >
          Years experience
        </p>
      </div>
    </div>
  </div>
</section>
