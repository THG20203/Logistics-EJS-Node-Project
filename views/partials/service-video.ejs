<section class="service-video">
  <div class="service-video__content">
    <!-- Video -->
    <div class="video-wrapper">
      <video class="video-wrapper__video" preload="metadata">
        <source src="/assets/videos/services-video.mp4" type="video/mp4" />
      </video>
      <button class="video-wrapper__play" aria-label="Play video">
        <svg viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>
    </div>
    <!-- Stats -->
    <div class="service-video__stats">
      <div class="service-video__stat">
        <span
          class="material-symbols-outlined service-video__icon"
          aria-hidden="true"
        >
          local_shipping
        </span>
        <h3 class="h3 service-video__heading">200+</h3>
        <p class="mt-sm service-card__paragraph">Modern vehicles</p>
      </div>
      <div class="service-video__stat">
        <span
          class="material-symbols-outlined service-video__icon"
          aria-hidden="true"
        >
          move_up
        </span>
        <h3 class="h3 service-video__heading">10,000+</h3>
        <p class="mt-sm service-card__paragraph">Loads moved each year</p>
      </div>
      <div class="service-video__stat">
        <span
          class="material-symbols-outlined service-video__icon"
          aria-hidden="true"
        >
          verified
        </span>
        <h3 class="h3 service-video__heading">99.5%</h3>
        <p class="mt-sm service-card__paragraph">Damage-free consignments</p>
      </div>
      <div class="service-video__stat">
        <span
          class="material-symbols-outlined service-video__icon"
          aria-hidden="true"
        >
          history
        </span>
        <h3 class="h3 service-video__heading">25+ Years</h3>
        <p class="mt-sm service-card__paragraph">Experience in haulage</p>
      </div>
    </div>
  </div>
</section>
